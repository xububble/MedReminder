<?xml version="1.0" encoding="utf-8"?>
<!-- 提醒弹窗：全屏 40% 遮罩 + 居中 iOS Alert 卡片 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alert_mask"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mask">

    <LinearLayout
        android:layout_width="@dimen/alert_width"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_alert"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="28dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/alert_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="💊"
            android:textSize="48sp" />

        <TextView
            android:id="@+id/alert_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:textColor="@color/text_main"
            android:textSize="@dimen/text_title_2"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alert_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_subhead" />

        <Button
            android:id="@+id/btn_not_yet"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_secondary_button"
            android:text="@string/btn_not_yet"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body" />

        <Button
            android:id="@+id/btn_eaten"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_primary_button"
            android:text="@string/btn_eaten"
            android:textColor="@color/card"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
